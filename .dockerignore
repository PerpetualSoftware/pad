# Build artifacts
pad
pad.exe
dist/

# Web build (rebuilt in Docker)
web/build/
web/build-materializer/
web/build-mcp-app/
web/node_modules/
web/.svelte-kit/

# Local data
.pad/
.pad.toml
*.db
*.sqlite
*.sqlite3

# Env files hold real credentials (POSTGRES_PASSWORD, PAD_ENCRYPTION_KEY; see
# .env.example). The Go builder stage copies the whole context, so anything
# not excluded here lands in its layers and in any build cache. `**/` matches
# at every depth, the root included.
**/.env
**/.env.*
!**/.env.example

# Dev files
.git/
.github/
.vscode/
.idea/
v1-archive/

# OS
.DS_Store
Thumbs.db
