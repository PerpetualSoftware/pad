		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.8",
		"@types/d3-scale": "4.0.9",
		"@types/qrcode": "^1.5.6",
