		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "5.1.0",
		"zod": "4.6.7"
	},
	"overrides": {
		"cookie": "^2.0.1",
		"linkify-it": "^5.0.2",
